# PlacementAI Backend Environment Variables Example

# MongoDB Database Config
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=placement_ai

# JWT Security Config
# Run `openssl rand -hex 32` to generate a secure secret key
JWT_SECRET_KEY=9476839af7d3b5bc1a52e987c126dcf9f5e27a69b76c8c18730999af1d3b76e1
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# SMTP Email Dispatcher (Optional for local development - logs to console fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=user@example.com
SMTP_PASSWORD=secretpassword
SMTP_FROM_EMAIL=no-reply@placementai.com

# Client Application URL (For password reset links)
FRONTEND_URL=http://localhost:3000
