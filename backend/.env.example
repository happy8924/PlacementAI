# PlacementAI Backend Environment Variables
# Copy this file as .env and fill in the values

# MongoDB Database Config (Atlas Cluster0 — AWS Mumbai)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.8l4bkaf.mongodb.net/?appName=Cluster0&retryWrites=true&w=majority
MONGODB_DATABASE=placement_ai

# JWT Security Config
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# SMTP Email Dispatcher (Auth verification / reset passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=your_email@gmail.com

# Client Application URL
FRONTEND_URL=http://localhost:3000

# n8n Recruiter Job Broadcast Webhook URL
# e.g. https://your-n8n-instance.com/webhook/placementai-job-broadcast
N8N_WEBHOOK_URL=

# ── API Rate Limiting Configuration ──
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_LIMIT=100
RATE_LIMIT_DEFAULT_WINDOW=60
RATE_LIMIT_UNAUTH_LIMIT=30
RATE_LIMIT_UNAUTH_WINDOW=60

# Endpoint Specific Protection Limits
RATE_LIMIT_LOGIN_LIMIT=5
RATE_LIMIT_LOGIN_WINDOW=60
RATE_LIMIT_REGISTER_LIMIT=10
RATE_LIMIT_REGISTER_WINDOW=60
RATE_LIMIT_OTP_GEN_LIMIT=3
RATE_LIMIT_OTP_GEN_WINDOW=60
RATE_LIMIT_OTP_VERIFY_LIMIT=5
RATE_LIMIT_OTP_VERIFY_WINDOW=60
RATE_LIMIT_FORGOT_PASSWORD_LIMIT=3
RATE_LIMIT_FORGOT_PASSWORD_WINDOW=60
RATE_LIMIT_RESET_PASSWORD_LIMIT=5
RATE_LIMIT_RESET_PASSWORD_WINDOW=60
RATE_LIMIT_RESUME_UPLOAD_LIMIT=10
RATE_LIMIT_RESUME_UPLOAD_WINDOW=60
RATE_LIMIT_AI_ANALYSIS_LIMIT=5
RATE_LIMIT_AI_ANALYSIS_WINDOW=60
RATE_LIMIT_AI_MOCK_INTERVIEW_LIMIT=5
RATE_LIMIT_AI_MOCK_INTERVIEW_WINDOW=60

# Trusted reverse proxies for client IP extraction (comma-separated)
RATE_LIMIT_TRUSTED_PROXIES=127.0.0.1,::1

# Distributed Redis Store URL (Optional; defaults to thread-safe in-memory sliding window)
# e.g. redis://localhost:6379/0
REDIS_URL=
