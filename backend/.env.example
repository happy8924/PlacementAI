# PlacementAI Backend Environment Variables
# Copy this file as .env and fill in the values

# MongoDB Database Config (Atlas Cluster0 — AWS Mumbai)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.8l4bkaf.mongodb.net/?appName=Cluster0&retryWrites=true&w=majority
MONGODB_DATABASE=placement_ai

# JWT Security Config
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# SMTP Email Dispatcher
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=your_email@gmail.com

# Client Application URL
FRONTEND_URL=http://localhost:3000
