        "jsCode": "const d = $('Build Email HTML').item.json;\nconst err = ($json && $json.error) ? ($json.error.message || JSON.stringify($json.error)) : 'Email send failed';\nreturn { json: {\n  jobId: d.jobId,\n  job_id: d.jobId,\n  studentId: d.studentId,\n  student_id: d.studentId,\n  studentName: d.studentName,\n  studentEmail: d.studentEmail,\n  companyName: (d.job && d.job.companyName) || '',\n  jobTitle: (d.job && d.job.jobTitle) || '',\n  dispatchId: d.dispatchId || '',\n  sentAt: new Date().toISOString(),\n  status: 'failed',\n  errorMessage: String(err)\n} };"
      },
      "id": "a1100001-0001-4000-8000-000000000013",
