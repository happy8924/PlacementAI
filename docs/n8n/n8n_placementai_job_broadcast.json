      "id": "a1100001-0001-4000-8000-000000000001",
      "name": "PlacementAI Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -500,
        450
      ],
      "webhookId": "placementai-job-broadcast"
    },
    {
      "parameters": {
        "jsCode": "// Extract payload from Webhook input (handles both direct body and wrapped body)\nconst raw = $input.first().json;\nconst data = raw.body ? raw.body : raw;\n\nconst errors = [];\nif (!data.job) errors.push('Missing job object in payload');\nif (!data.dispatch_id) errors.push('Missing dispatch_id in payload');\n\nconst recipients = Array.isArray(data.recipients) ? data.recipients : [];\nconst job = data.job || {};\nconst dispatchId = data.dispatch_id || '';\n\nreturn [{\n  json: {\n    isValid: errors.length === 0,\n    errors,\n    job,\n    recipients,\n    recipientCount: recipients.length,\n    dispatchId\n  }\n}];"
      },
      "id": "a1100001-0001-4000-8000-000000000002",
      "name": "Validate Webhook Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -280,
        450
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "valid",
              "leftValue": "={{ $json.isValid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1100001-0001-4000-8000-000000000003",
      "name": "Is Payload Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        -80,
        450
      ]
    },
    {
      "parameters": {
        "jsCode": "const errs = $input.first().json.errors || ['Invalid payload structure'];\nreturn [{\n  json: {\n    success: false,\n    status: 'error',\n    message: 'Webhook payload validation failed',\n    errors: errs\n  }\n}];"
      },
      "id": "a1100001-0001-4000-8000-000000000004",
      "name": "Return Payload Error",
      "type": "n8n-nodes-base.code",
