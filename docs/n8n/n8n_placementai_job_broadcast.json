      "id": "a1100001-0001-4000-8000-000000000005",
      "name": "Has Eligible Recipients?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        120,
        350
      ]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nreturn [{\n  json: {\n    success: true,\n    status: 'no_match',\n    dispatch_id: data.dispatchId,\n    jobId: data.job.jobId || data.job.job_id,\n    message: 'No eligible candidates found for this job broadcast.'\n  }\n}];"
      },
      "id": "a1100001-0001-4000-8000-000000000006",
      "name": "No Eligible Students",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        350,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst job = data.job || {};\nconst jobId = job.jobId || job.job_id || '';\nconst dispatchId = data.dispatchId || '';\nconst recipients = data.recipients || [];\n\nreturn recipients.map((r) => ({\n  json: {\n    dispatchId,\n    jobId,\n    studentId: r.studentId || r.student_id,\n    studentName: r.studentName || r.student_name || 'Candidate',\n    studentEmail: r.studentEmail || r.student_email,\n    matchScore: r.matchScore || r.match_score || 100,\n    matchedSkills: r.matchedSkills || r.matched_skills || [],\n    job\n  }\n}));"
      },
      "id": "a1100001-0001-4000-8000-000000000007",
      "name": "Unpack Recipients Queue",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        350,
        450
      ]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "a1100001-0001-4000-8000-000000000008",
      "name": "For Each Eligible Student",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        580,
        450
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const d = $json;\nconst job = d.job || {};\nconst esc = (v) => String(v == null ? '' : v)\n  .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\nconst list = (arr) => Array.isArray(arr) && arr.length ? arr.map(esc).join(', ') : '—';\n\nconst subject = 'New Job Opportunity: ' + esc(job.jobTitle) + ' at ' + esc(job.companyName);\n\nconst html = `<!DOCTYPE html>\n<html>\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"></head>\n<body style=\"margin:0;padding:0;background:#f4f5f7;font-family:Arial,Helvetica,sans-serif;color:#1a1a1a;\">\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f4f5f7;padding:24px 0;\">\n    <tr><td align=\"center\">\n      <table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:600px;width:100%;background:#ffffff;border-radius:8px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,0.08);\">\n        <tr><td style=\"background:#0b5fff;padding:24px;color:#ffffff;\">\n          <h1 style=\"margin:0;font-size:20px;\">${esc(job.jobTitle)}</h1>\n          <p style=\"margin:6px 0 0;font-size:14px;opacity:.9;\">${esc(job.companyName)}</p>\n        </td></tr>\n        <tr><td style=\"padding:24px;\">\n          <p style=\"margin:0 0 16px;font-size:15px;\">Hello ${esc(d.studentName)},</p>\n          <p style=\"margin:0 0 20px;font-size:14px;line-height:1.5;\">A new job opportunity has been posted that matches your profile.</p>\n          <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"font-size:14px;line-height:1.6;\">\n            <tr><td style=\"padding:4px 0;width:170px;color:#666;\">Role</td><td style=\"padding:4px 0;\"><strong>${esc(job.role)}</strong></td></tr>\n            <tr><td style=\"padding:4px 0;color:#666;\">Department</td><td style=\"padding:4px 0;\">${esc(job.department) || '—'}</td></tr>\n            <tr><td style=\"padding:4px 0;color:#666;\">Employment Type</td><td style=\"padding:4px 0;\">${esc(job.employmentType)}</td></tr>\n            <tr><td style=\"padding:4px 0;color:#666;\">Location</td><td style=\"padding:4px 0;\">${esc(job.location)}</td></tr>\n            <tr><td style=\"padding:4px 0;color:#666;\">Work Mode</td><td style=\"padding:4px 0;\">${esc(job.workMode)}</td></tr>\n            <tr><td style=\"padding:4px 0;color:#666;\">Salary / Stipend</td><td style=\"padding:4px 0;\">${esc(job.salaryOrStipend) || '—'}</td></tr>\n            <tr><td style=\"padding:4px 0;color:#666;\">Experience</td><td style=\"padding:4px 0;\">${esc(job.experienceRequired) || '—'}</td></tr>\n            <tr><td style=\"padding:4px 0;color:#666;\">Minimum CGPA</td><td style=\"padding:4px 0;\">${esc(job.minimumCGPA)}</td></tr>\n            <tr><td style=\"padding:4px 0;color:#666;\">Required Skills</td><td style=\"padding:4px 0;\">${list(job.requiredSkills)}</td></tr>\n            <tr><td style=\"padding:4px 0;color:#666;\">Application Deadline</td><td style=\"padding:4px 0;\">${esc(job.applicationDeadline) || '—'}</td></tr>\n          </table>\n          <div style=\"margin:20px 0;padding:16px;background:#f8f9fb;border-radius:6px;font-size:14px;line-height:1.6;\">\n            <strong>Job Description</strong><br>${esc(job.jobDescription)}\n          </div>\n          <div style=\"margin:0 0 20px;font-size:14px;line-height:1.6;\">\n            <strong>Selection Process</strong><br>${list(job.selectionProcess)}\n          </div>\n          <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"border-radius:6px;background:#0b5fff;\">\n            <a href=\"${esc(job.applyLink)}\" style=\"display:inline-block;padding:12px 28px;font-size:15px;color:#ffffff;text-decoration:none;font-weight:bold;\">Apply Now</a>\n          </td></tr></table>\n          <p style=\"margin:16px 0 0;font-size:13px;color:#666;\">Apply link: <a href=\"${esc(job.applyLink)}\" style=\"color:#0b5fff;\">${esc(job.applyLink)}</a></p>\n        </td></tr>\n        <tr><td style=\"padding:20px 24px;background:#f8f9fb;font-size:13px;color:#666;\">\n          Regards,<br><strong>${esc(job.companyName)}</strong><br>Recruitment Team\n        </td></tr>\n      </table>\n    </td></tr>\n  </table>\n</body>\n</html>`;\n\nreturn { json: Object.assign({}, d, { emailSubject: subject, emailHtml: html }) };"
      },
